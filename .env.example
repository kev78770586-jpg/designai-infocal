# =============================================================================
# VARIABLES DE ENTORNO - DESIGNAI (INFOCAL SANTA CRUZ)
# =============================================================================

# Entorno y Puerto del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=designai_db

# Sesiones y Seguridad
SESSION_SECRET=designai_infocal_secret_key_2026_super_secure

# Google Gemini API
# Clave oficial de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_gemini_api_aqui

# Modelo Gemini a utilizar (Por defecto: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Límites de Archivos (en bytes - 10MB por defecto)
MAX_FILE_SIZE=10485760
